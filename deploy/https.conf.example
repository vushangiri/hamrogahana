# Replace jewellery.example.com and certificate paths. Mount as nginx.conf for direct TLS.
server {
    listen 80;
    server_name jewellery.example.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name jewellery.example.com;
    ssl_certificate /etc/letsencrypt/live/jewellery.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jewellery.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 102m;
    gzip on;
    gzip_types text/css application/javascript application/json;
    location / {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 130s;
    }
}
