# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-at-least-32-random-characters
# Use hex to avoid URI escaping issues in Compose DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex-password
COOKIE_SECURE=0
# Set COOKIE_SECURE=1 behind HTTPS in production.
GEOCODER_AGENT=HamroGahana/1.0 (contact: replace-with-real-email@example.com)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
